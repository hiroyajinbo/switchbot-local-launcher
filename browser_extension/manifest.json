{
  "manifest_version": 3,
  "name": "SwitchBot Local Launcher",
  "version": "0.1.0",
  "description": "PCアプリに登録したSwitchBotクイック操作をツールバーから実行します。",
  "action": {
    "default_title": "SwitchBot クイック操作",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ]
}
